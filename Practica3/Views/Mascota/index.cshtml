@model Practica3.Models.listamascotas

@{
    ViewData["Title"] = "Gestión de Mascotas";
}

<div class="text-center">
    <h2>Gestión de Mascotas - Veterinaria</h2>
    <hr />
    <p>
        <a asp-action="Registrar" class="btn btn-primary">Registrar Nueva Mascota</a>
    </p>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Código Único</th>
                <th>Nombre</th>
                <th>Propietario</th>
                <th>Estado</th>
                <th>Tipo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @{
                // Obtenemos los elementos de tu lista enlazada
                var mascotas = Model.ObtenerTodas();
            }
            @if (mascotas.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center">No hay mascotas registradas en el sistema.</td>
                </tr>
            }
            else
            {
                @foreach (var mascota in mascotas)
                {
                    <tr>
                        <td>@mascota.CodigoUnico</td>
                        <td>@mascota.Nombre</td>
                        <td>@mascota.Propietario</td>
                        <td>@mascota.Estado</td>
                        <td>@mascota.GetType().Name</td>
                        <td>
                            <a asp-action="Detalle" asp-route-id="@mascota.CodigoUnico" class="btn btn-info btn-sm">Gestionar / Ver</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>